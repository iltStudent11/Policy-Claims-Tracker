{
  "info": {
    "name": "Policy Claims Tracker API",
    "description": "Postman collection for capstone-api. Covers auth, policies, claims, and dashboard flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "policyId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@capstone.local"
    },
    {
      "key": "adminPassword",
      "value": "Password123!"
    },
    {
      "key": "newUserEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (random email)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `user_${Date.now()}@capstone.local`;",
                  "pm.environment.set('newUserEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"Password123!\",\n  \"role\": \"adjuster\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login (seed admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Policies",
      "item": [
        {
          "name": "List Policies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list policies returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "const first = json?.data?.[0];",
                  "if (first?._id) pm.environment.set('policyId', first._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Policy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create policy returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "const id = json?.data?._id;",
                  "if (id) pm.environment.set('policyId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyNumber\": \"POL-PM-{{$timestamp}}\",\n  \"holderName\": \"Postman Holder\",\n  \"type\": \"auto\",\n  \"premium\": 999.99,\n  \"status\": \"active\",\n  \"effectiveDate\": \"2026-01-01\",\n  \"expirationDate\": \"2027-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Policy by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies",
                "{{policyId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "Create Claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create claim returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "const id = json?.data?._id;",
                  "if (id) pm.environment.set('claimId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy\": \"{{policyId}}\",\n  \"description\": \"Postman test claim\",\n  \"incidentDate\": \"2026-09-15\",\n  \"amount\": 1200,\n  \"status\": \"submitted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Claim by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Claim Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Investigating claim from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "notes"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Claim Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"under-review\",\n  \"amount\": 1300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Claim Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "stats"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Claim",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
