{
  "name": "capstone-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed.ts",
    "verify:auth-password": "tsx src/verifyAuthPasswordExposure.ts",
    "postman:test": "newman run postman/Policy-Claims-Tracker.postman_collection.json -e postman/Policy-Claims-Tracker.local.postman_environment.json",
    "postman:test:bail": "npm run postman:test -- --bail"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "newman": "^6.2.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0"
  }
}
